<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
  // dev-hub#320 Welle 3 Teil 3 (iilgmbh/iil-klickdummy#232/#233-Analogie):
  // (a) tokens.css nachladen wie kd-nav.js, wenn --kd-primary noch nicht auf
  //     :root definiert ist — relativer Pfad "_shared/tokens.css" (Konvention
  //     wie kd-nav.js/check_i5.py). Anders als kd-nav.js (Skript in einem
  //     Host-Dokument) braucht diese Seite selbst keine Skript-Pfad-Auflösung
  //     — sie IST das Dokument, ein relativer <link>-href löst schon gegen
  //     ihre eigene Basis-URL auf. Bewusst KEIN Hex-Fallback: fehlt die Datei,
  //     bleibt die Chrome ungestylt statt geraten.
  // (b) [data-theme="dark"] auf <html> setzen, wenn die OS-Präferenz dunkel
  //     ist — ersetzt den vorherigen hartkodierten `@media (prefers-color-
  //     scheme: dark)`-Hex-Block; tokens.css liefert (falls vom Profil per
  //     `colours_dark` unterstützt, siehe gen_tokens.py) selbst einen
  //     `[data-theme="dark"]`-Block. Fehlt der im Profil, bleibt es beim
  //     Hell-Layout — kein zweiter Hex-Quellcode hier.
  (function () {
    try {
      var v = getComputedStyle(document.documentElement).getPropertyValue('--kd-primary');
      if (!v || !v.trim()) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '_shared/tokens.css';
        document.head.appendChild(link);
      }
    } catch (e) { /* Chrome bleibt ungestylt statt geraten */ }
    try {
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      var applyTheme = function () { document.documentElement.dataset.theme = mq.matches ? 'dark' : 'light'; };
      applyTheme();
      if (mq.addEventListener) mq.addEventListener('change', applyTheme);
      else if (mq.addListener) mq.addListener(applyTheme);
    } catch (e) { /* matchMedia nicht verfügbar — Hell-Theme bleibt aktiv */ }
  })();
</script>
<title>Klickdummy-Browser · __REPO_LABEL__</title>
<style>
  :root {
    /* Zwei-Layer-Token-System (platform:ADR-049) — lokale --pui-*-Bridge, keine
       shared UI-Lib (ADR-200 paused). Werte kommen seit dev-hub#320 Welle 3
       Teil 3 aus `var(--kd-*)`-Tokens (tokens.css, gen_tokens.py) statt aus
       Hex-Literalen (AP-007) — Kern-Tokens ohne Fallback (Konvention wie
       kd-nav.js), optionale Tokens mit Fallback-Kette auf ein Kern-Token. */
    --pui-primary:   var(--kd-primary);
    --pui-surface:   var(--kd-zebra, var(--kd-bg-light));
    --pui-surface-2: var(--kd-bg-light);
    --pui-border:    var(--kd-border);
    --pui-muted:     var(--kd-text-muted);
    --pui-success:   var(--kd-success, var(--kd-accent-2));
    --pui-space-1: 4px;
    --pui-space-2: 8px;
    --pui-space-3: 12px;
    --pui-space-4: 16px;
    --pui-radius:   6px;
    --pui-radius-lg: 8px;
    --pui-badge-mock-bg: var(--kd-info, var(--kd-accent-1));         --pui-badge-mock-fg: var(--kd-bg-light);
    --pui-badge-stub-bg: var(--kd-warning, var(--kd-accent-1));      --pui-badge-stub-fg: var(--kd-text);
    --pui-badge-story-bg: var(--kd-accent-2, var(--kd-accent-1));    --pui-badge-story-fg: var(--kd-bg-light);
    --pui-badge-specdemo-bg: var(--kd-success, var(--kd-accent-2));  --pui-badge-specdemo-fg: var(--kd-bg-light);
    /* aktiver Stepper-Eintrag — vorher Inline-Hex im Selektor (AP-007-Rest) */
    --pui-step-active-bg:     var(--kd-zebra, var(--kd-bg-light));
    --pui-step-active-border: var(--kd-primary);
  }
  *, *::before, *::after { box-sizing: border-box; }
  /* [hidden] robust durchsetzen — sonst überschreibt display:flex/block das
     Attribut (UA-Regel [hidden]{display:none} hat zu geringe Spezifität). */
  [hidden]{display:none!important}
  body { font-family: system-ui, -apple-system, sans-serif; margin: 0; height: 100vh; display: flex; color: var(--pui-primary); }
  aside { width: 320px; padding: var(--pui-space-4); border-right: 1px solid var(--pui-border); background: var(--pui-surface); overflow-y: auto; }
  aside h1 { font-size: 16px; margin: 0 0 var(--pui-space-3); }
  .meta { font-size: 11px; color: var(--pui-muted); }
  label { display: block; font-size: 11px; color: var(--pui-muted); margin-top: var(--pui-space-3); margin-bottom: var(--pui-space-1); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  select { width: 100%; font-family: inherit; font-size: 13px; padding: var(--pui-space-1) var(--pui-space-2); border: 1px solid var(--pui-border); border-radius: var(--pui-radius); background: var(--pui-surface-2); }
  select:disabled { opacity: .5; }
  .detail { margin-top: var(--pui-space-4); padding: var(--pui-space-3); background: var(--pui-surface-2); border: 1px solid var(--pui-border); border-radius: var(--pui-radius-lg); font-size: 12px; }
  .detail dt { font-weight: 600; color: var(--pui-primary); margin-top: var(--pui-space-2); }
  .detail dt:first-child { margin-top: 0; }
  .detail dd { margin: 2px 0 0; }
  code { background: var(--pui-surface); padding: 1px 4px; border-radius: 3px; font-size: 11px; }
  .badge { display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 10px; font-weight: 600; }
  .badge.mock { background: var(--pui-badge-mock-bg); color: var(--pui-badge-mock-fg); }
  .badge.stub-demo { background: var(--pui-badge-stub-bg); color: var(--pui-badge-stub-fg); }
  .badge.story { background: var(--pui-badge-story-bg); color: var(--pui-badge-story-fg); }
  .badge.spec-demo { background: var(--pui-badge-specdemo-bg); color: var(--pui-badge-specdemo-fg); }
  .mode-toggle { display: flex; gap: var(--pui-space-1); margin-top: var(--pui-space-3); }
  .mode-toggle button { flex: 1; padding: var(--pui-space-1) var(--pui-space-2); font-size: 12px; border: 1px solid var(--pui-border); border-radius: var(--pui-radius); background: var(--pui-surface-2); color: var(--pui-muted); cursor: pointer; font-family: inherit; }
  .mode-toggle button[aria-pressed="true"] { background: var(--pui-primary); color: var(--pui-surface-2); border-color: var(--pui-primary); font-weight: 600; }
  .story-progress { font-size: 11px; color: var(--pui-muted); margin: var(--pui-space-2) 0 var(--pui-space-1); }
  .story-stepper { list-style: none; margin: 0 0 var(--pui-space-3); padding: 0; }
  .story-stepper li { display: flex; align-items: flex-start; gap: var(--pui-space-2); padding: var(--pui-space-1) var(--pui-space-2); border-radius: var(--pui-radius); font-size: 12px; cursor: pointer; border: 1px solid transparent; }
  .story-stepper li[data-active="true"] { background: var(--pui-step-active-bg); border-color: var(--pui-step-active-border); font-weight: 600; }
  .story-stepper li[data-visited="true"] .step-icon { color: var(--pui-success); }
  /* N6 (a11y): Stepper-Einträge sind role="button" + tabindex — ohne sichtbaren
     Fokusring wären sie zwar erreichbar, aber nicht auffindbar. */
  .story-stepper li:focus-visible, .story-nav button:focus-visible,
  .mode-toggle button:focus-visible, select:focus-visible,
  .link-list a:focus-visible { outline: 2px solid var(--pui-primary); outline-offset: 2px; }
  .link-card { max-width: 560px; text-align: left; background: var(--pui-surface-2); border: 1px solid var(--pui-border); border-radius: var(--pui-radius-lg); padding: var(--pui-space-4); }
  .link-card h2 { font-size: 14px; margin: 0 0 var(--pui-space-2); color: var(--pui-primary); }
  .link-card p { margin: 0 0 var(--pui-space-3); font-size: 13px; line-height: 1.5; }
  .link-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--pui-space-2); }
  .link-list a { color: var(--pui-primary); font-size: 13px; }
  .story-nav { display: flex; gap: var(--pui-space-2); }
  .story-nav button { flex: 1; padding: var(--pui-space-1) var(--pui-space-2); font-size: 12px; border: 1px solid var(--pui-border); border-radius: var(--pui-radius); background: var(--pui-surface-2); color: var(--pui-primary); cursor: pointer; font-family: inherit; font-weight: 600; }
  .story-nav button:disabled { opacity: .35; cursor: default; }
  main { flex: 1; display: flex; flex-direction: column; }
  .empty { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--pui-muted); font-size: 14px; padding: var(--pui-space-4); text-align: center; }
  .error { color: var(--pui-badge-stub-fg); background: var(--pui-badge-stub-bg); }
  iframe { flex: 1; width: 100%; border: 0; }
  footer { padding: var(--pui-space-1) var(--pui-space-4); font-size: 10px; color: var(--pui-muted); border-top: 1px solid var(--pui-border); background: var(--pui-surface); }
  input[type="search"] { width: 100%; font-family: inherit; font-size: 13px; padding: var(--pui-space-1) var(--pui-space-2); border: 1px solid var(--pui-border); border-radius: var(--pui-radius); background: var(--pui-surface-2); color: inherit; }
  input[type="search"]:focus-visible { outline: 2px solid var(--pui-primary); outline-offset: 2px; }
  .linklike { margin-top: var(--pui-space-2); padding: 0; border: 0; background: none; color: var(--pui-muted); font-family: inherit; font-size: 11px; text-decoration: underline; cursor: pointer; }
  .linklike:focus-visible { outline: 2px solid var(--pui-primary); outline-offset: 2px; }

  /* Responsive: unter 720px liegt die Sidebar oben statt links — vorher blieb
     bei fixen 320px Seitenleiste kein nutzbarer Renderbereich übrig. */
  @media (max-width: 720px) {
    body { flex-direction: column; height: auto; min-height: 100vh; }
    aside { width: 100%; max-height: 50vh; border-right: 0; border-bottom: 1px solid var(--pui-border); }
    main { min-height: 50vh; }
  }

  /* Dark Mode: nur die Token-Ebene wird umdefiniert — alle Regeln oben greifen
     unverändert weiter (das ist der Zweck des --pui-*-Layers, ADR-049).
     dev-hub#320 Welle 3 Teil 3: die `--kd-*`-Werte selbst kommen jetzt aus
     tokens.css' `[data-theme="dark"]`-Block (gen_tokens.py `colours_dark`,
     vom Bootstrap-Script oben anhand der OS-Präferenz gesetzt) — hier bleiben
     nur die zwei strukturellen Regeln, die kein zweites Hex brauchen. */
  [data-theme="dark"] body { background: var(--pui-surface-2); }
  /* Der aktive Modus-Button färbt Text mit --pui-surface-2 — im Dunkeln wäre
     das Text auf Text. Hier explizit gegen die dunkle Fläche setzen. */
  [data-theme="dark"] .mode-toggle button[aria-pressed="true"] { background: var(--pui-primary); color: var(--pui-surface); }
</style>
</head>
<body>
<aside>
  <h1>🗂 Klickdummies</h1>
  <div class="meta">Repo: <code data-testid="repo-label" id="repo-label">__REPO_LABEL__</code> · platform:ADR-211</div>

  <div class="mode-toggle" data-testid="mode-toggle" id="mode-toggle" hidden>
    <button data-testid="btn-free" id="btn-free" data-mode="free" aria-pressed="true">🗂 Frei</button>
