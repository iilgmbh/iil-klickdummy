<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>Klickdummy-Browser · __REPO_LABEL__</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, sans-serif; margin: 0; height: 100vh; display: flex; color: #1a3a6c; }
  aside { width: 320px; padding: 16px; border-right: 1px solid #d8e0e8; background: #f8fafc; overflow-y: auto; display: flex; flex-direction: column; gap: 0; }
  aside h1 { font-size: 16px; margin: 0 0 12px; }
  aside .meta { font-size: 11px; color: #6a7888; }
  aside label { display: block; font-size: 11px; color: #6a7888; margin-top: 12px; margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  aside select { width: 100%; font-family: inherit; font-size: 13px; padding: 6px 8px; border: 1px solid #d8e0e8; border-radius: 6px; background: #fff; }
  aside .detail { margin-top: 16px; padding: 12px; background: #fff; border: 1px solid #d8e0e8; border-radius: 8px; font-size: 12px; }
  aside .detail dt { font-weight: 600; color: #3a4a5a; margin-top: 6px; }
  aside .detail dt:first-child { margin-top: 0; }
  aside .detail dd { margin: 2px 0 0; color: #1a3a6c; }
  aside .detail dd code { background: #f3f4f6; padding: 1px 4px; border-radius: 3px; font-size: 11px; }
  aside .badge { display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 10px; font-weight: 600; }
  aside .badge.mock { background: #e0f2fe; color: #075985; }
  aside .badge.stub-demo { background: #fef3c7; color: #92400e; }
  aside .badge.story { background: #f3e8ff; color: #6b21a8; }
  aside .badge.spec-demo { background: #dcfce7; color: #166534; }
  /* Mode Toggle */
  .mode-toggle { display: flex; gap: 4px; margin-bottom: 12px; }
  .mode-toggle button { flex: 1; padding: 5px 8px; font-size: 12px; border: 1px solid #d8e0e8; border-radius: 6px; background: #fff; color: #6a7888; cursor: pointer; font-family: inherit; }
  .mode-toggle button.active { background: #1a3a6c; color: #fff; border-color: #1a3a6c; font-weight: 600; }
  /* Story stepper */
  .story-panel { display: none; }
  .story-panel.visible { display: block; }
  .free-panel { display: block; }
  .free-panel.hidden { display: none; }
  .story-progress { font-size: 11px; color: #6a7888; margin: 8px 0 6px; }
  .story-stepper { list-style: none; margin: 0 0 12px; padding: 0; }
  .story-stepper li { display: flex; align-items: flex-start; gap: 8px; padding: 6px 8px; border-radius: 6px; font-size: 12px; cursor: pointer; border: 1px solid transparent; }
  .story-stepper li:hover { background: #eef2f7; }
  .story-stepper li.active { background: #e8eef8; border-color: #c5d5ec; font-weight: 600; color: #1a3a6c; }
  .story-stepper li.visited .step-icon { color: #22c55e; }
  .step-icon { font-size: 13px; min-width: 16px; }
  .step-label { line-height: 1.3; }
  .story-nav { display: flex; gap: 8px; margin-top: 4px; }
  .story-nav button { flex: 1; padding: 7px 10px; font-size: 12px; border: 1px solid #d8e0e8; border-radius: 6px; background: #fff; color: #1a3a6c; cursor: pointer; font-family: inherit; font-weight: 600; }
  .story-nav button:hover:not(:disabled) { background: #1a3a6c; color: #fff; border-color: #1a3a6c; }
  .story-nav button:disabled { opacity: 0.35; cursor: default; }
  main { flex: 1; display: flex; flex-direction: column; }
  main .empty { flex: 1; display: flex; align-items: center; justify-content: center; color: #8893a3; font-size: 14px; }
  main iframe { flex: 1; width: 100%; border: 0; }
  footer { padding: 6px 16px; font-size: 10px; color: #8893a3; border-top: 1px solid #e5e9ef; background: #f8fafc; }
  footer a { color: #1a3a6c; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
</style>
</head>
<body>
<aside>
  <h1>🗂 Klickdummies</h1>
  <div class="meta">Repo: <code id="repo-label">__REPO_LABEL__</code> · platform:ADR-211 Rev 14</div>

  <!-- Mode Toggle (nur sichtbar wenn Stories vorhanden) -->
  <div class="mode-toggle" id="mode-toggle" style="display:none;margin-top:12px">
    <button id="btn-free" class="active" onclick="setMode('free')">🗂 Frei</button>
    <button id="btn-story" onclick="setMode('story')">📖 Story-Walk</button>
  </div>

  <!-- Frei-Modus -->
  <div class="free-panel" id="free-panel">
    <label for="kd-select">Klickdummy</label>
    <select id="kd-select"></select>

    <label for="ver-select">Spec-Version</label>
    <select id="ver-select">
      <option value="current">aktuell (HEAD)</option>
    </select>

    <div class="detail" id="kd-detail">
      <em>Klickdummy auswählen…</em>
    </div>
  </div>

  <!-- Story-Walk-Modus -->
  <div class="story-panel" id="story-panel">
    <label for="story-select">Story</label>
    <select id="story-select"></select>

    <div class="story-progress" id="story-progress"></div>
    <ul class="story-stepper" id="story-stepper"></ul>

    <div class="story-nav">
      <button id="btn-prev" onclick="storyNav(-1)" disabled>← Zurück</button>
      <button id="btn-next" onclick="storyNav(1)" disabled>Weiter →</button>
    </div>
  </div>
</aside>
<main>
  <div class="empty" id="empty">Klickdummy links auswählen, um ihn rechts zu laden.</div>
  <iframe id="kd-frame" style="display:none" title="Aktiver Klickdummy"></iframe>
</main>
<footer>
  Generiert durch <code>iil-klickdummy</code> v1.2 · Browser-Snippet · <a href="https://github.com/achimdehnert/platform/blob/main/docs/adr/ADR-211-klickdummy-benutzeranforderungen-entwicklungsprozess.md">platform:ADR-211</a>
</footer>

<script>
'use strict';
const KLICKDUMMIES = __KLICKDUMMIES_JSON__;
const STORIES = __STORIES_JSON__;

// ── Frei-Modus ──────────────────────────────────────────────────────────────

function populateFree() {
  var sel = document.getElementById('kd-select');
  sel.innerHTML = '<option value="">— wählen —</option>' +
    KLICKDUMMIES.map(function(k, i) {
      return '<option value="' + i + '">' + k.title + ' (v' + k.spec_version + ')</option>';
    }).join('');
  sel.addEventListener('change', function() { onSelectFree(sel.value); });
}

function onSelectFree(idx) {
  if (idx === '' || idx === null) return;
  var k = KLICKDUMMIES[parseInt(idx, 10)];
  if (!k) return;
  var det = document.getElementById('kd-detail');
  det.innerHTML =
    '<dt>Spec</dt><dd><code>' + k.spec_id + '</code> v' + k.spec_version + '</dd>' +
    '<dt>Klasse</dt><dd><span class="badge ' + k.class + '">' + k.class + '</span></dd>' +
    '<dt>ADR</dt><dd>' + (k.adr_local ? '<code>' + k.adr_local + '</code>' : '<em>kein ADR-Ref</em>') + '</dd>' +
    (k.sister_of && k.sister_of.length
      ? '<dt>Schwester-Klickdummies</dt><dd>' + k.sister_of.map(function(s) { return '<code>' + s + '</code>'; }).join(', ') + '</dd>'
      : '') +
    '<dt>Spec-Pfad</dt><dd><code>' + k.path + '</code></dd>';
  loadKD(k);
}

// ── Story-Modus ─────────────────────────────────────────────────────────────

var currentStoryIdx = 0;
var currentStepIdx = 0;

function populateStories() {
  var sel = document.getElementById('story-select');
  sel.innerHTML = STORIES.map(function(s, i) {
    return '<option value="' + i + '">' + s.title + ' (' + s.steps.length + ' Schritte)</option>';
  }).join('');
  sel.addEventListener('change', function() { loadStory(parseInt(sel.value, 10), 0); });
}

function loadStory(storyIdx, stepIdx) {
  currentStoryIdx = storyIdx;
  currentStepIdx = stepIdx;
  var story = STORIES[storyIdx];
  renderStepper(story, stepIdx);
  var step = story.steps[stepIdx];
  var k = KLICKDUMMIES[step.kd_index];
  if (k) loadKD(k);
  updateNavButtons(story, stepIdx);
}

function renderStepper(story, activeStep) {
  document.getElementById('story-progress').textContent =
    'Schritt ' + (activeStep + 1) + ' / ' + story.steps.length;
  var ul = document.getElementById('story-stepper');
  ul.innerHTML = story.steps.map(function(step, i) {
    var visited = isVisited(story.id, i);
    var icon = i === activeStep ? '●' : (visited ? '✅' : '○');
    var cls = (i === activeStep ? ' active' : '') + (visited ? ' visited' : '');
    return '<li class="' + cls.trim() + '" onclick="loadStory(' + currentStoryIdx + ',' + i + ')">' +
      '<span class="step-icon">' + icon + '</span>' +
      '<span class="step-label">' + step.label + '</span></li>';
  }).join('');
  markVisited(story.id, activeStep);
}

function updateNavButtons(story, stepIdx) {
  document.getElementById('btn-prev').disabled = stepIdx === 0;
  document.getElementById('btn-next').disabled = stepIdx === story.steps.length - 1;
}

function storyNav(delta) {
  var story = STORIES[currentStoryIdx];
  var next = currentStepIdx + delta;
  if (next < 0 || next >= story.steps.length) return;
  loadStory(currentStoryIdx, next);
}

// Visited-State via localStorage (pro Story-Session)
function visitedKey(storyId, stepIdx) { return 'kd-story-visited:' + storyId + ':' + stepIdx; }
function isVisited(storyId, stepIdx) { try { return !!localStorage.getItem(visitedKey(storyId, stepIdx)); } catch(e) { return false; } }
function markVisited(storyId, stepIdx) { try { localStorage.setItem(visitedKey(storyId, stepIdx), '1'); } catch(e) {} }

// ── iframe-Loader ────────────────────────────────────────────────────────────

function loadKD(k) {
  var frame = document.getElementById('kd-frame');
  var empty = document.getElementById('empty');
  if (k.shell_path) {
    frame.src = k.shell_path + '?feedback=on';
    frame.style.display = '';
    empty.style.display = 'none';
  } else {
    empty.textContent = 'Kein shell.html für ' + k.name + ' gefunden (nur Spec vorhanden).';
    frame.style.display = 'none';
    empty.style.display = '';
  }
}

// ── Mode-Toggle ──────────────────────────────────────────────────────────────

function setMode(mode) {
  var isStory = mode === 'story';
  document.getElementById('free-panel').classList.toggle('hidden', isStory);
  document.getElementById('story-panel').classList.toggle('visible', isStory);
  document.getElementById('btn-free').classList.toggle('active', !isStory);
  document.getElementById('btn-story').classList.toggle('active', isStory);
  if (isStory && STORIES.length > 0) loadStory(currentStoryIdx, 0);
}

// ── Init ─────────────────────────────────────────────────────────────────────

document.addEventListener('DOMContentLoaded', function() {
  populateFree();
  if (STORIES.length > 0) {
    document.getElementById('mode-toggle').style.display = '';
    populateStories();
  }
});
</script>
</body>
</html>
